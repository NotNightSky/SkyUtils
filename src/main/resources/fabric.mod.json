{
  "schemaVersion": 1,
  "id": "skyutils",
  "version": "${version}",

  "name": "SkyUtils",
  "description": "An utility mod created by NotNightSky",
  "authors": ["NotNightSky"],
  "contact": {
    "homepage": "https://modrinth.com/mod/skyutil",
    "sources": "https://github.com/XMODERLIVE/skyutils",
    "issues": "https://github.com/XMODERLIVE/skyutils/issues"
  },

  "license": "GPL-3.0",
  "icon": "assets/skyutils/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "net.notnightsky.skyutils.SkyutilsClient"
    ],
    "modmenu": ["net.notnightsky.skyutils.modmenu.modMenuIntegration"]
  },
  "custom": {
    "modmenu": {
      "update_checker": true
    }
  },
  "mixins": [
    "skyutils.mixins.json"
  ],

  "accessWidener": "skyutils.classtweaker",

  "depends": {
    "fabricloader": ">=$loader_version",
    "minecraft": "~$minecraft_version",
    "java": ">=$java_version",
    "fabric-api": ">=$fabric_api_version",
    "yet_another_config_lib_v3": ">=$yacl_version"
  },
  "suggests": {
    "modmenu": ">=$modmenu_version"
  }
}
